{
  "rules": {
    "presence": {
      "$workspaceId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['online', 'lastActiveAt'])"
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
