rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Daftar admin ditambahkan manual lewat Firebase Console (Firestore > Data),
    // tidak bisa dibuat/ditulis dari aplikasi client demi keamanan.
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    // customers/{customerId} = profil singkat tiap pengunjung (nama, pesan terakhir, dst).
    // customerId sama dengan uid anonim milik pengunjung itu sendiri.
    match /customers/{customerId} {
      allow read: if request.auth != null &&
        (request.auth.uid == customerId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == customerId;
      allow update: if request.auth != null &&
        (request.auth.uid == customerId || isAdmin());
      allow delete: if false;
    }

    // chats/{customerId}/messages = isi percakapan customer tsb dengan admin.
    match /chats/{customerId}/messages/{messageId} {
      allow read: if request.auth != null &&
        (request.auth.uid == customerId || isAdmin());

      allow create: if request.auth != null &&
        (
          (request.auth.uid == customerId && request.resource.data.sender == 'customer') ||
          (isAdmin() && request.resource.data.sender == 'admin')
        );

      allow update, delete: if false;
    }
  }
}
