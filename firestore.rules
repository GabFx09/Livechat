rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Setiap user hanya boleh menulis dokumen profilnya sendiri (uid-nya),
    // tapi semua user yang sudah login (anonim) boleh membaca daftar user.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // chatId adalah gabungan dua uid yang diurutkan, dipisah "_".
    // Hanya dua orang yang uid-nya ada di dalam chatId yang boleh akses.
    match /chats/{chatId}/messages/{messageId} {
      allow read: if request.auth != null &&
        chatId.split('_').hasAny([request.auth.uid]);

      allow create: if request.auth != null &&
        chatId.split('_').hasAny([request.auth.uid]) &&
        request.resource.data.senderId == request.auth.uid;

      allow update, delete: if false;
    }
  }
}
