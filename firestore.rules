rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // adminIndex/{uid} = penunjuk cepat "admin ini kerja di workspace mana".
    // Dibuat manual oleh pemilik platform lewat Firebase Console saat
    // membuat admin baru, tidak bisa dibuat/diubah dari aplikasi client.
    match /adminIndex/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // workspaces/{workspaceId} = 1 dokumen per perusahaan (nama, brandName,
    // themeColor, bubbleIcon, dst). Dokumennya sendiri dibuat manual oleh
    // pemilik platform, tapi field appearance (brandName/themeColor/bubbleIcon)
    // dan sapaan otomatis (autoGreetingEnabled/autoGreetingMessage) boleh
    // diedit admin workspace tsb lewat menu Pengaturan > Appearance/Auto-Chat.
    // Read dibuka publik (tanpa perlu login) supaya widget.js di website
    // perusahaan bisa ambil branding-nya tanpa proses auth dulu.
    match /workspaces/{workspaceId} {
      allow read: if true;
      allow create: if false;
      allow delete: if false;

      function isWorkspaceAdmin() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/workspaces/$(workspaceId)/admins/$(request.auth.uid));
      }

      allow update: if isWorkspaceAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['brandName', 'themeColor', 'bubbleIcon', 'autoGreetingEnabled', 'autoGreetingMessage',
           'autoGreetingOptions', 'autoGreetingOptionReplies']
        );

      // Dokumen admin dibuat manual lewat Firebase Console, tidak bisa
      // dibuat dari aplikasi client. Admin yang bersangkutan boleh
      // mengubah profilnya sendiri (nama tampilan, foto).
      match /admins/{adminId} {
        allow read: if request.auth != null && request.auth.uid == adminId;
        allow create: if false;
        allow update: if request.auth != null && request.auth.uid == adminId;
        allow delete: if false;

        match /savedReplies/{replyId} {
          allow read, write: if request.auth != null && request.auth.uid == adminId;
        }
      }

      // customers/{customerId} = profil singkat tiap pengunjung workspace ini.
      // customerId sama dengan uid anonim milik pengunjung itu sendiri.
      match /customers/{customerId} {
        allow read: if request.auth != null && request.auth.uid == customerId;
        allow read: if isWorkspaceAdmin();

        allow create: if request.auth != null && request.auth.uid == customerId;

        allow update: if request.auth != null && request.auth.uid == customerId;
        allow update: if isWorkspaceAdmin();

        // Admin boleh hapus dokumen customer, dipakai fitur "Hapus Semua Chat"
        // (menghapus profil + sesi customer sekaligus, bukan customer sendiri).
        allow delete: if isWorkspaceAdmin();
      }

      // chats/{customerId}/messages = isi percakapan customer tsb dengan admin workspace ini.
      match /chats/{customerId}/messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid == customerId;
        allow read: if isWorkspaceAdmin();

        // exists(...) di baris terakhir menolak kiriman kalau dokumen
        // customers/{customerId}-nya sudah dihapus admin (fitur "Hapus
        // Semua Chat") -- customer wajib mulai sesi baru dulu (yang bikin
        // ulang dokumennya) sebelum bisa kirim pesan lagi.
        allow create: if request.auth != null &&
          request.auth.uid == customerId &&
          request.resource.data.sender == 'customer' &&
          request.resource.data.type in ['text', 'image'] &&
          exists(/databases/$(database)/documents/workspaces/$(workspaceId)/customers/$(customerId));

        allow create: if isWorkspaceAdmin() &&
          request.resource.data.sender == 'admin' &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.type in ['text', 'image'];

        // Sapaan otomatis (fitur Pengaturan > Auto-Chat): customer sendiri
        // yang nulis pesan ini (bukan admin asli, makanya tidak ada
        // senderId), tapi teksnya wajib sama persis dengan autoGreetingMessage
        // yang di-set admin di workspace doc -- customer tidak bisa
        // menyamar jadi admin dengan teks bebas.
        allow create: if request.auth != null &&
          request.auth.uid == customerId &&
          request.resource.data.sender == 'admin' &&
          request.resource.data.type == 'text' &&
          request.resource.data.autoGreeting == true &&
          request.resource.data.text ==
            get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.autoGreetingMessage;

        // Menu pilihan bantuan yang menyusul sapaan (juga fitur Pengaturan >
        // Auto-Chat). Sama polanya: array pilihannya wajib sama persis
        // dengan autoGreetingOptions di workspace doc, dan hasOnly membatasi
        // field yang boleh disentuh supaya customer tidak bisa menyelundupkan
        // field lain (mis. senderPhoto) lewat celah ini.
        allow create: if request.auth != null &&
          request.auth.uid == customerId &&
          request.resource.data.sender == 'admin' &&
          request.resource.data.type == 'options' &&
          request.resource.data.autoGreeting == true &&
          request.resource.data.keys().hasOnly(['sender', 'type', 'autoGreeting', 'options', 'timestamp']) &&
          request.resource.data.options ==
            get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.autoGreetingOptions;

        // Balasan otomatis begitu customer klik salah satu pilihan bantuan.
        // optionLabel nunjuk baris mana di map autoGreetingOptionReplies yang
        // harus dicocokkan -- teksnya wajib sama persis dengan isi map itu,
        // jadi customer tidak bisa nyuruh "admin" bilang apa saja.
        allow create: if request.auth != null &&
          request.auth.uid == customerId &&
          request.resource.data.sender == 'admin' &&
          request.resource.data.type == 'text' &&
          request.resource.data.autoReply == true &&
          request.resource.data.keys().hasOnly(['sender', 'type', 'autoReply', 'optionLabel', 'text', 'timestamp']) &&
          request.resource.data.text ==
            get(/databases/$(database)/documents/workspaces/$(workspaceId))
              .data.autoGreetingOptionReplies[request.resource.data.optionLabel];

        allow update: if isWorkspaceAdmin() &&
          resource.data.sender == 'admin' &&
          resource.data.senderId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'editedAt']);

        // Hapus per-pesan dari UI dibatasi ke pesan admin sendiri (lihat
        // isOwnMessage di admin.js, tombol hapus cuma muncul di situ), tapi
        // fitur "Hapus Semua Chat" perlu menghapus pesan customer juga --
        // jadi izin di sini dibuka untuk admin workspace ybs secara umum.
        allow delete: if isWorkspaceAdmin();
      }

      // deletionLogs/{logId} = jejak audit tiap kali admin pakai "Hapus Semua
      // Chat". Dibuat terpisah dari customers/{customerId} karena dokumen itu
      // sendiri justru ikut terhapus oleh aksi yang sedang dicatat. Log ini
      // sengaja tidak bisa diubah/dihapus siapa pun (termasuk admin) supaya
      // riwayatnya tetap bisa dipercaya.
      match /deletionLogs/{logId} {
        allow read: if isWorkspaceAdmin();

        allow create: if isWorkspaceAdmin() &&
          request.resource.data.deletedBy == request.auth.uid;

        allow update: if false;
        allow delete: if false;

        // Salinan tiap pesan yang ikut terhapus, dipindah ke sini apa
        // adanya (bukan ditulis ulang) sebelum dokumen aslinya dihapus --
        // sama-sama read-only permanen begitu tersimpan.
        match /messages/{messageId} {
          allow read: if isWorkspaceAdmin();
          allow create: if isWorkspaceAdmin();
          allow update: if false;
          allow delete: if false;
        }
      }

      // stats/{YYYY-MM-DD} = counter harian untuk dashboard statistik admin.
      // Customer & admin sama-sama boleh menambah counter (efek samping wajar
      // dari kirim pesan/mulai chat), tapi cuma admin yang boleh membacanya,
      // dan field yang boleh disentuh dibatasi ke 4 counter yang dikenal.
      match /stats/{date} {
        allow read: if isWorkspaceAdmin();

        allow create: if request.auth != null &&
          request.resource.data.keys().hasOnly(
            ['messageCount', 'customerMessageCount', 'adminMessageCount', 'newCustomers']
          );

        allow update: if request.auth != null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['messageCount', 'customerMessageCount', 'adminMessageCount', 'newCustomers']
          );

        allow delete: if false;
      }
    }
  }
}
