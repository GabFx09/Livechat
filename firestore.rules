rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // inviteCodes/{code} = kode undangan buat signup mandiri workspace baru
    // (Pengaturan > lihat halaman signup.html). Dokumennya sendiri dibuat
    // manual oleh pemilik platform lewat Console (Document ID = kode itu
    // sendiri, mis. "TOKOABC2026"), field awal { used: false,
    // claimedWorkspaceId: null }. Satu-satunya perubahan yang diizinkan:
    // dari belum dipakai jadi dipakai DAN langsung terikat ke SATU
    // workspaceId tertentu, dalam satu write atomik (compare-and-swap ke
    // satu dokumen, jadi tidak ada celah race/klaim-dulu-ikat-belakangan
    // yang bisa dipakai berulang buat bikin banyak workspace dari 1 kode).
    match /inviteCodes/{code} {
      allow read: if false;
      allow create: if false;
      allow update: if request.auth != null &&
        resource.data.used == false &&
        resource.data.claimedWorkspaceId == null &&
        request.resource.data.used == true &&
        request.resource.data.usedByUid == request.auth.uid &&
        request.resource.data.claimedWorkspaceId is string &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['used', 'usedByUid', 'usedAt', 'claimedWorkspaceId']
        );
      allow delete: if false;
    }

    // Dipakai adminIndex & workspaces/{id}/admins di bawah -- cek apakah
    // workspaceId ini memang baru dibuat lewat kode undangan yang diklaim
    // oleh uid yang sedang request sekarang.
    function workspaceClaimedBySelf(workspaceId) {
      let ws = get(/databases/$(database)/documents/workspaces/$(workspaceId));
      let code = get(/databases/$(database)/documents/inviteCodes/$(ws.data.signupInviteCode));
      return code.data.usedByUid == request.auth.uid;
    }

    // adminIndex/{uid} = penunjuk cepat "admin ini kerja di workspace mana".
    // Dibuat manual oleh pemilik platform lewat Firebase Console untuk admin
    // yang dionboarding manual, ATAU otomatis oleh signup.html untuk admin
    // yang daftar mandiri pakai kode undangan (lihat workspaceClaimedBySelf
    // di atas) -- kedua jalur berakhir di bentuk dokumen yang sama.
    // Setelah dibuat tidak bisa diubah lagi lewat jalur mana pun.
    match /adminIndex/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['workspaceId']) &&
        workspaceClaimedBySelf(request.resource.data.workspaceId);

      allow update: if false;
      allow delete: if false;
    }

    // workspaces/{workspaceId} = 1 dokumen per perusahaan (nama, brandName,
    // themeColor, bubbleIcon, dst). Dokumennya bisa dibuat manual oleh
    // pemilik platform lewat Console (onboarding lama), ATAU otomatis lewat
    // signup.html kalau disertai kode undangan yang valid & sudah diklaim
    // uid ybs (lihat inviteCodes & workspaceClaimedBySelf di atas) --
    // signupInviteCode ikut tersimpan permanen di dokumennya sebagai jejak
    // "workspace ini dibuat lewat kode yang mana", dipakai rule admins &
    // adminIndex buat verifikasi ulang. Field appearance
    // (brandName/themeColor/bubbleIcon) dan sapaan otomatis
    // (autoGreetingEnabled/autoGreetingMessage) boleh diedit admin
    // workspace tsb lewat menu Pengaturan > Appearance/Auto-Chat. Read
    // dibuka publik (tanpa perlu login) supaya widget.js di website
    // perusahaan bisa ambil branding-nya tanpa proses auth dulu.
    match /workspaces/{workspaceId} {
      allow read: if true;

      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['name', 'brandName', 'themeColor', 'bubbleIcon', 'signupInviteCode']) &&
        request.resource.data.signupInviteCode is string &&
        get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.signupInviteCode)).data.usedByUid == request.auth.uid &&
        get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.signupInviteCode)).data.claimedWorkspaceId == workspaceId;

      allow delete: if false;

      function isWorkspaceAdmin() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/workspaces/$(workspaceId)/admins/$(request.auth.uid));
      }

      // Anti-spam ringan buat pesan customer (lihat pemakaiannya di
      // chats/{customerId}/messages di bawah): tolak kalau belum 500ms
      // sejak pesan sebelumnya dari customer yg sama. Tidak kerasa buat
      // orang beneran yg ngetik manual, tapi cukup nahan script yg nembak
      // banyak pesan per detik.
      function customerNotSpamming(customerId) {
        let cust = get(/databases/$(database)/documents/workspaces/$(workspaceId)/customers/$(customerId));
        return !('lastMessageAt' in cust.data) ||
          cust.data.lastMessageAt == null ||
          request.time > cust.data.lastMessageAt + duration.value(500, 'ms');
      }

      allow update: if isWorkspaceAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['brandName', 'themeColor', 'bubbleIcon', 'autoGreetingEnabled', 'autoGreetingMessage',
           'autoGreetingOptions', 'autoGreetingOptionReplies', 'businessHoursEnabled',
           'businessHoursDays', 'businessHoursStart', 'businessHoursEnd', 'offlineMessage']
        );

      // Dokumen admin dibuat manual lewat Firebase Console (onboarding lama),
      // ATAU otomatis oleh signup.html buat diri sendiri di workspace yang
      // baru saja dibuatnya sendiri lewat kode undangan (workspaceClaimedBySelf
      // di atas). Admin yang bersangkutan boleh mengubah profilnya sendiri
      // (nama tampilan, foto) kapan pun setelahnya.
      match /admins/{adminId} {
        allow read: if request.auth != null && request.auth.uid == adminId;

        allow create: if request.auth != null &&
          request.auth.uid == adminId &&
          workspaceClaimedBySelf(workspaceId);

        allow update: if request.auth != null && request.auth.uid == adminId;
        allow delete: if false;

        match /savedReplies/{replyId} {
          allow read, write: if request.auth != null && request.auth.uid == adminId;
        }
      }

      // customers/{customerId} = profil singkat tiap pengunjung workspace ini.
      // customerId sama dengan uid anonim milik pengunjung itu sendiri.
      match /customers/{customerId} {
        allow read: if request.auth != null && request.auth.uid == customerId;
        allow read: if isWorkspaceAdmin();

        allow create: if request.auth != null && request.auth.uid == customerId;

        allow update: if request.auth != null && request.auth.uid == customerId;
        allow update: if isWorkspaceAdmin();

        // Admin boleh hapus dokumen customer, dipakai fitur "Hapus Semua Chat"
        // (menghapus profil + sesi customer sekaligus, bukan customer sendiri).
        allow delete: if isWorkspaceAdmin();
      }

      // chats/{customerId}/messages = isi percakapan customer tsb dengan admin workspace ini.
      match /chats/{customerId}/messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid == customerId;
        allow read: if isWorkspaceAdmin();

        // exists(...) menolak kiriman kalau dokumen customers/{customerId}-nya
        // sudah dihapus admin (fitur "Hapus Semua Chat") -- customer wajib
        // mulai sesi baru dulu (yang bikin ulang dokumennya) sebelum bisa
        // kirim pesan lagi. Batas panjang teks & customerNotSpamming() di
        // atas adalah lapisan anti-spam tambahan.
        allow create: if request.auth != null &&
          request.auth.uid == customerId &&
          request.resource.data.sender == 'customer' &&
          request.resource.data.type in ['text', 'image'] &&
          (request.resource.data.type != 'text' || request.resource.data.text.size() <= 4000) &&
          exists(/databases/$(database)/documents/workspaces/$(workspaceId)/customers/$(customerId)) &&
          customerNotSpamming(customerId);

        allow create: if isWorkspaceAdmin() &&
          request.resource.data.sender == 'admin' &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.type in ['text', 'image'];

        // Sapaan otomatis (fitur Pengaturan > Auto-Chat): customer sendiri
        // yang nulis pesan ini (bukan admin asli, makanya tidak ada
        // senderId), tapi teksnya wajib sama persis dengan autoGreetingMessage
        // yang di-set admin di workspace doc -- customer tidak bisa
        // menyamar jadi admin dengan teks bebas.
        allow create: if request.auth != null &&
          request.auth.uid == customerId &&
          request.resource.data.sender == 'admin' &&
          request.resource.data.type == 'text' &&
          request.resource.data.autoGreeting == true &&
          request.resource.data.text ==
            get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.autoGreetingMessage;

        // Menu pilihan bantuan yang menyusul sapaan (juga fitur Pengaturan >
        // Auto-Chat). Sama polanya: array pilihannya wajib sama persis
        // dengan autoGreetingOptions di workspace doc, dan hasOnly membatasi
        // field yang boleh disentuh supaya customer tidak bisa menyelundupkan
        // field lain (mis. senderPhoto) lewat celah ini.
        allow create: if request.auth != null &&
          request.auth.uid == customerId &&
          request.resource.data.sender == 'admin' &&
          request.resource.data.type == 'options' &&
          request.resource.data.autoGreeting == true &&
          request.resource.data.keys().hasOnly(['sender', 'type', 'autoGreeting', 'options', 'timestamp']) &&
          request.resource.data.options ==
            get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.autoGreetingOptions;

        // Balasan otomatis begitu customer klik salah satu pilihan bantuan.
        // optionLabel nunjuk baris mana di map autoGreetingOptionReplies yang
        // harus dicocokkan -- teksnya wajib sama persis dengan isi map itu,
        // jadi customer tidak bisa nyuruh "admin" bilang apa saja.
        allow create: if request.auth != null &&
          request.auth.uid == customerId &&
          request.resource.data.sender == 'admin' &&
          request.resource.data.type == 'text' &&
          request.resource.data.autoReply == true &&
          request.resource.data.keys().hasOnly(['sender', 'type', 'autoReply', 'optionLabel', 'text', 'timestamp']) &&
          request.resource.data.text ==
            get(/databases/$(database)/documents/workspaces/$(workspaceId))
              .data.autoGreetingOptionReplies[request.resource.data.optionLabel];

        allow update: if isWorkspaceAdmin() &&
          resource.data.sender == 'admin' &&
          resource.data.senderId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'editedAt']);

        // Hapus per-pesan dari UI dibatasi ke pesan admin sendiri (lihat
        // isOwnMessage di admin.js, tombol hapus cuma muncul di situ), tapi
        // fitur "Hapus Semua Chat" perlu menghapus pesan customer juga --
        // jadi izin di sini dibuka untuk admin workspace ybs secara umum.
        allow delete: if isWorkspaceAdmin();
      }

      // deletionLogs/{logId} = jejak audit tiap kali admin pakai "Hapus Semua
      // Chat". Dibuat terpisah dari customers/{customerId} karena dokumen itu
      // sendiri justru ikut terhapus oleh aksi yang sedang dicatat. Log ini
      // sengaja tidak bisa diubah/dihapus siapa pun (termasuk admin) supaya
      // riwayatnya tetap bisa dipercaya.
      match /deletionLogs/{logId} {
        allow read: if isWorkspaceAdmin();

        allow create: if isWorkspaceAdmin() &&
          request.resource.data.deletedBy == request.auth.uid;

        allow update: if false;
        allow delete: if false;

        // Salinan tiap pesan yang ikut terhapus, dipindah ke sini apa
        // adanya (bukan ditulis ulang) sebelum dokumen aslinya dihapus --
        // sama-sama read-only permanen begitu tersimpan.
        match /messages/{messageId} {
          allow read: if isWorkspaceAdmin();
          allow create: if isWorkspaceAdmin();
          allow update: if false;
          allow delete: if false;
        }
      }

      // stats/{YYYY-MM-DD} = counter harian untuk dashboard statistik admin.
      // Customer & admin sama-sama boleh menambah counter (efek samping wajar
      // dari kirim pesan/mulai chat/kasih rating), tapi cuma admin yang boleh
      // membacanya, dan field yang boleh disentuh dibatasi ke yang dikenal.
      // firstResponseTotalMs/firstResponseCount dipakai kartu "Respon
      // Pertama", ratingTotal/ratingCount dipakai kartu "Rating Kepuasan" --
      // keduanya rata-rata = total/count, dihitung di admin.js pas nampilin.
      match /stats/{date} {
        allow read: if isWorkspaceAdmin();

        allow create: if request.auth != null &&
          request.resource.data.keys().hasOnly([
            'messageCount', 'customerMessageCount', 'adminMessageCount', 'newCustomers',
            'firstResponseTotalMs', 'firstResponseCount', 'ratingTotal', 'ratingCount'
          ]);

        allow update: if request.auth != null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'messageCount', 'customerMessageCount', 'adminMessageCount', 'newCustomers',
            'firstResponseTotalMs', 'firstResponseCount', 'ratingTotal', 'ratingCount'
          ]);

        allow delete: if false;
      }
    }
  }
}
